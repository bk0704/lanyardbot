# Copy to .env and fill in. All five are required -- the bot refuses to start
# if any is missing or blank. Never commit the filled-in .env.

# Discord Developer Portal -> your application -> Bot -> Token
DISCORD_TOKEN=''

# resend.com -> API Keys
RESEND_API_KEY=''

# The address codes are sent from. Must be on a domain verified with Resend.
EMAIL_FROM='noreply@example.com'

# The institution domain users must have an address on.
# Must keep the leading '@'.
ALLOWED_DOMAIN='@example.edu'

# Any Postgres. Neon's free tier works.
DATABASE_URL='postgresql://user:password@host/dbname?sslmode=require'
